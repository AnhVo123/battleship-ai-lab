{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build local web UI",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"build"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run Battleship Strategy Lab",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\scripts\\start.ps1"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}